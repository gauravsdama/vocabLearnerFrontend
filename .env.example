# Copy to `.env.local` for local development only.

# Optional override. If unset, the app defaults to:
# - dev: http://localhost:8000
# - prod: https://vocab-backend-219277558905.us-central1.run.app
VITE_API_BASE_URL=http://localhost:8000

# Optional provider config for local auth testing.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_WEB_CLIENT_ID=

# Dev-only diagnostics toggle.
VITE_TRACE_UI=false
