{
  "name": "vocabcat-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "rm -rf .tmp-test-dist && tsc -p tsconfig.tests.json && node --test .tmp-test-dist/tests/*.test.js",
    "test:component": "vitest run",
    "test:security": "vitest run tests/api-client.security.test.ts tests/contract-test.test.ts tests/diagnostics.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@react-oauth/google": "^0.13.5",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^4.1.7"
  }
}
