{
  "name": "vocabcat-frontend",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:unit": "rm -rf .tmp-test-dist && tsc -p tsconfig.tests.json && node --test .tmp-test-dist/tests/*.test.js",
    "test:component": "vitest run",
    "test:security": "vitest run tests/api-client.security.test.ts tests/contract-test.test.ts tests/diagnostics.test.ts tests/vercel-config.test.ts",
    "test:e2e": "playwright test",
    "copy:check": "node scripts/check-copy.mjs",
    "copy:inventory": "node scripts/inventory-ui-copy.mjs --write",
    "copy:inventory:check": "node scripts/inventory-ui-copy.mjs",
    "license:check": "node scripts/check-licensing.mjs",
    "assets:check": "node scripts/check-asset-budget.mjs",
    "support-boundary:check": "node scripts/check-support-boundary.mjs",
    "audit:prod": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fontsource-variable/sora": "^5.3.0",
    "@react-oauth/google": "^0.13.5",
    "@vercel/analytics": "^2.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "playwright": "^1.60.0",
    "typescript": "^5.5.4",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
