{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "outDir": ".tmp-test-dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "src/vite-env.d.ts",
    "src/api/signing.ts",
    "src/utils/learningTargets.ts",
    "src/utils/messageUtils.ts",
    "src/feed/progressState.ts",
    "src/auth/policy.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "tests/api-client.security.test.ts",
    "tests/auth-guards.test.tsx",
    "tests/contract-test.test.ts",
    "tests/diagnostics.test.ts",
    "tests/vercel-config.test.ts",
    "tests/playwright/**"
  ]
}
